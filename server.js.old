const express = require("express");
const multer = require("multer");
const fs = require("fs");
const path = require("path");

const app = express();

// dossier stockage (ton disque actuel)
const STORAGE = "./storage";

// créer dossier si pas existant
if (!fs.existsSync(STORAGE)) {
  fs.mkdirSync(STORAGE);
}

// multer temp
const upload = multer({ dest: "temp/" });

// ---------- DB ----------

function readDB() {
  try {
    return JSON.parse(fs.readFileSync("files.json"));
  } catch {
    return {};
  }
}

function writeDB(data) {
  fs.writeFileSync("files.json", JSON.stringify(data, null, 2));
}

function generateID() {
  return Math.random().toString(36).slice(2, 8);
}

// ---------- ROUTES ----------

// test
app.get("/", (req, res) => {
  res.send("BonkDrop OK 🔥");
});

// upload
app.post("/upload", upload.single("file"), (req, res) => {
  if (!req.file) {
    return res.status(400).send("Aucun fichier");
  }

  const id = generateID();
  const ext = path.extname(req.file.originalname);
  const filename = id + ext;

  const finalPath = path.join(STORAGE, filename);

  // déplacer fichier
  fs.renameSync(req.file.path, finalPath);

  // save DB
  const db = readDB();
  db[id] = finalPath;
  writeDB(db);

  // renvoyer lien propre
  res.json({
    url: `http://192.168.1.99:3000/${id}`
  });
});

// download
app.get("/:id", (req, res) => {
  const id = req.params.id;
  const db = readDB();

  const filePath = db[id];

  if (!filePath || !fs.existsSync(filePath)) {
    return res.status(404).send("Fichier introuvable");
  }

  res.download(filePath);
});

// start
app.listen(3000, () => {
  console.log("Serveur lancé sur http://localhost:3000");
});
