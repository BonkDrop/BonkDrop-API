# STORAGE_PATH=/home/BonkDrop/bonkdrop_data/storage
# TEMP_PATH=/home/BonkDrop/temp
# DB_FILE_PATH=/home/BonkDrop/bonkdrop_data/files.json
# CORS_ORIGINS=https://bonkdrop.fr,https://www.bonkdrop.fr,http://localhost:5173
